his.phase === 'MALFUNCTION') {\n                    this.executeCutaway();\n                }\n"]]},{"start1":5038,"length1":123,"diffs":[[1,""]]},{"start1":5830,"length1":280,"diffs":[[1,"        this.env.surfaceWindKts = Math.round(Math.random() * 16 - 8);\n        if (Math.abs(this.env.surfaceWindKts) < 3) {\n            this.env.surfaceWindKts = 6;\n"]]},{"start1":6004,"length1":43,"diffs":[[1,""]]},{"start1":7640,"length1":216,"diffs":[[1,""]]},{"start1":7727,"length1":204,"diffs":[[1,"        const dt = Math.min((timestamp - this.lastTimestamp) / 1000, 0.05);\n"]]},{"start1":9028,"length1":45,"diffs":[[1,""]]},{"start1":9427,"length1":0,"diffs":[[1,"\n            if (this.player.altitude <= 0) {\n                this.player.altitude = 0;\n                this.finishJump();\n                return;\n            }\n"]]},{"start1":9634,"length1":175,"diffs":[[1,"            this.player.flaring = flareInput && this.player.altitude <= 120;\n"]]},{"start1":11050,"length1":62,"diffs":[[1,"        // Touchdown Check\n"]]},{"start1":11760,"length1":70,"diffs":[[1,""]]},{"start1":11786,"length1":131,"diffs":[[1,"            pullAlt >= this.OPTIMAL_PULL_MIN && pullAlt <= this.OPTIMAL_PULL_MAX;\n"]]},{"start1":11869,"length1":394,"diffs":[[1,"        const epScore =\n            this.player.epReactionTime === null\n                ? true\n                : this.player.epReactionTime <= this.MAX_EP_TIME;\n"]]},{"start1":16372,"length1":128,"diffs":[[1,""]]},{"start1":16417,"length1":32,"diffs":[[1,""]]},{"start1":19162,"length1":32,"diffs":[[1,""]]},{"start1":22197,"length1":416,"diffs":[[1,"        const pullDisplay =\n            this.player.pullAltitude !== null ? `${this.player.pullAltitude} ft` : 'AAD Auto';\n"]]},{"start1":22321,"length1":428,"diffs":[[1,"        const epDisplay =\n            this.player.epReactionTime !== null\n                ? `${this.player.epReactionTime}s (Target ≤ 3.0s)`\n                : 'N/A (Clean Open)';\n"]]},{"start1":22715,"length1":1